# Every variable this service reads, and nothing else.
#
# Rule 9 of docs/ecosystem/03 §2: a repository declares the variables it needs and the deploy
# provides exactly those. `env_file: .env` fan-out — which hands every container the whole estate's
# secrets — is banned, and this file is what makes the alternative possible.
#
# Copy to `.env` for local work. `.env` is gitignored and must stay that way.

# --- required --------------------------------------------------------------------------------

# This service's own database. It reads no other, and CI fails on a second connection string.
NDA_DATABASE_URL=postgres://nda:nda@127.0.0.1:5432/nda

# ── SERVING BOTH NETWORKS FROM ONE POD ────────────────────────────────────────
#
# Both OPTIONAL and empty here: a development stack is one network. Set the first
# in the estate, where one pod answers for mainnet and testnet and the gateway
# stamps `CF-Network` on every request. See micro-deploy
# `docs/network-consolidation.md`.
NDA_DATABASE_URL_TESTNET=
# ── WHICH ESTATE THIS DEPLOYMENT IS ───────────────────────────────────────────
#
# REQUIRED in the estate, and the render sets it for every pod. It was once
# documented here as "never in production" and that was wrong twice over:
#
#   1. The pod keys its own database handle by it. Without it a testnet
#      deployment registers its testnet DSN under the name `mainnet` and then
#      refuses every request stamped `CF-Network: testnet`.
#
#   2. SERVICE-TO-SERVICE CALLS NEVER REACH THE GATEWAY. An outbox relay POSTing
#      to another service goes container to container; nothing stamps a header
#      on it and nothing can. Without a declared network those answer 500.
#
# The header still WINS when present, so this cannot mask a mis-stamped request
# from outside — it only answers the internal callers that never had one. Leave
# it empty only where a pod genuinely serves both estates.
CF_NETWORK_SINGLE=


# Identity's JWKS and issuer. Token verification is the only thing this service asks identity for.
IDENTITY_JWKS_URL=http://127.0.0.1:4001/.well-known/jwks.json
IDENTITY_ISSUER=http://127.0.0.1:4001

# HMAC key for event signatures — outbound AND INBOUND.
#
# This is the key that verifies inbound events on POST /v1/events. Two topics arrive there:
# `billing.entitlement.granted` and `identity.user.deleted`. A webhook with no MAC lets anyone who
# can reach the port assert that an account was deleted, which in this service ERASES that account's
# link to every survivor it has in every world.
#
#   openssl rand -base64 48
#
# The boot guard checks the SHAPE of the value, not its length: base64 or hex only (a typed value
# has a hyphen or an underscore and is refused however long it is), at least 32 DECODED BYTES, and
# a measured entropy floor that rejects 64 zeros. There is no NODE_ENV exemption and no escape
# hatch — the placeholder that sat in a public compose file was 40 characters and passed every
# service in the estate (micro-org #142). Leaving a placeholder here is refused at boot,
# deliberately. Do not paste one back in.
OUTBOX_SIGNING_SECRET=CHANGE_ME_run_openssl_rand_base64_48

# The upstreams. Billing answers what an account owns (cosmetics); worlds owns the shared player
# profile and receives this title's achievements.
#
# There is deliberately NO LEDGER_URL. This service moves no value: cosmetics are billing
# entitlements, achievements are worlds rows, and the only integers it owns are game integers.
BILLING_URL=http://127.0.0.1:4009
WORLDS_URL=http://127.0.0.1:4000

# The long-lived credential this service exchanges for the short-lived token it presents to
# billing and worlds. NOT shared with any other service — SD-05. Identity mints for `service:nda`
# with the scopes nda needs: billing:read, billing:grant, worlds:read, worlds:write (to post
# achievements to the shared profile).
#
# THIS REPLACES NDA_SERVICE_TOKEN, which was a TOKEN — and a service token expires in 600 seconds
# (identity/src/tokens.ts:28). It was read once at boot and nothing re-minted it, so ten minutes
# into every deployment every call to billing and worlds started failing. Achievements are posted
# from a leased job, so that did not surface as a failed request a user saw: it surfaced as a
# backlog that retried, failed and dead-lettered quietly, hours after the deploy that caused it.
#
# A credential does not expire, is revocable, confers nothing by itself, and buys a fresh
# ten-minute token whenever one is needed. The ten minutes is unchanged: rotation IS expiry.
#
# `deploy/scripts/estate-bootstrap.sh` writes it to compose/estate/tokens.env. It begins `cfsc_`;
# if what you have begins `eyJ` it is a token, not a credential, and the service will refuse it.
#
# Technically optional — the image must be able to boot without one so CI can smoke-test /livez —
# but without it no call to a peer succeeds, and /readyz reports `identity-credential` as a hard
# failure so the replica takes no traffic.
# LEAVE IT EMPTY RATHER THAN FILLING IT IN WITH WORDS. Since micro-org #212 this is held to the
# credential SHAPE — `cfsc_` then a base64url body of at least 32 bytes, clearing a measured
# entropy floor — so `CHANGE_ME`, which used to sit here, is refused at boot rather than presented
# to a peer. Mint a real one: deploy/scripts/estate-bootstrap.sh
NDA_IDENTITY_CREDENTIAL=

# --- optional, with the defaults shown ---------------------------------------------------------

PORT=4110
NODE_ENV=development
LOG_LEVEL=info
NDA_DATABASE_POOL_MAX=10

# NDA_UPSTREAM_DEADLINE_MS=5000

# How long a `world.tick` lease is held, in milliseconds.
#
# **A SAFETY VALUE, NOT A TUNING KNOB.** A day resolution that outlives its lease can be claimed by
# a second worker while the first is still writing, which is the double-XP-and-double-days-survived
# defect 04-domain-model §10.5 names against `world.tick`. The day re-check in `persistDay` makes
# the second worker's write a no-op even then, but the lease is the first line and should comfortably
# exceed the slowest world's resolution. A floor of five seconds is enforced at boot.
# NDA_TICK_LEASE_MS=120000

# How many due worlds one sweep may enqueue. Bounds the work a single claim creates.
# NDA_TICK_BATCH_SIZE=50

# Names this replica in jobs.locked_by and in a lease's owner column. Defaults to the hostname,
# which is the container id under compose and the pod name under Kubernetes.
# INSTANCE_ID=

# The image tag, reported on every log line and in the release manifest.
# CLOUDSFORGE_TAG=dev

# --- not read by this service ------------------------------------------------------------------
#
# OTEL_EXPORTER_OTLP_ENDPOINT and the rest of OTEL_* are read by the OpenTelemetry SDK loaded ahead
# of the process, not by src/env.ts. They belong in the deploy, not here.
#
# NDA_TEST_DATABASE_URL is read only by the test suite, and only when its name contains "test" —
# the database-backed tests truncate every table this service owns.
#
# The ancestor also read CORS_ORIGINS, TRUST_PROXY and GAME_RATE_LIMIT_MAX. The browser does not
# talk to this service directly any more — `worlds-web` is a separate repository and the edge
# terminates both concerns — and a rate limiter keyed on a spoofable forwarded address was the thing
# the ancestor's own comment there was apologising for.
