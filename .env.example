# Every variable this service reads, and nothing else.
#
# Rule 9 of docs/ecosystem/03 §2: a repository declares the variables it needs and the deploy
# provides exactly those. `env_file: .env` fan-out — which hands every container the whole estate's
# secrets — is banned, and this file is what makes the alternative possible.
#
# Copy to `.env` for local work. `.env` is gitignored and must stay that way.

# --- required --------------------------------------------------------------------------------

# This service's own database. It reads no other, and CI fails on a second connection string.
NDA_DATABASE_URL=postgres://nda:nda@127.0.0.1:5432/nda

# Identity's JWKS and issuer. Token verification is the only thing this service asks identity for.
IDENTITY_JWKS_URL=http://127.0.0.1:4001/.well-known/jwks.json
IDENTITY_ISSUER=http://127.0.0.1:4001

# HMAC key for event signatures — outbound AND INBOUND.
#
# This is the key that verifies inbound events on POST /v1/events. Two topics arrive there:
# `billing.entitlement.granted` and `identity.user.deleted`. A webhook with no MAC lets anyone who
# can reach the port assert that an account was deleted, which in this service ERASES that account's
# link to every survivor it has in every world. At least 32 random characters:
#   openssl rand -base64 32
# Leaving a placeholder here (CHANGE_ME) is refused at boot, deliberately. Do not paste one back in.
OUTBOX_SIGNING_SECRET=CHANGE_ME

# The upstreams. Billing answers what an account owns (cosmetics); worlds owns the shared player
# profile and receives this title's achievements.
#
# There is deliberately NO LEDGER_URL. This service moves no value: cosmetics are billing
# entitlements, achievements are worlds rows, and the only integers it owns are game integers.
BILLING_URL=http://127.0.0.1:4009
WORLDS_URL=http://127.0.0.1:4000

# This service's own scoped credential. NOT shared with any other service — SD-05.
# It must carry: billing:read, worlds:write (to post achievements to the shared profile).
NDA_SERVICE_TOKEN=CHANGE_ME

# --- optional, with the defaults shown ---------------------------------------------------------

PORT=4110
NODE_ENV=development
LOG_LEVEL=info
NDA_DATABASE_POOL_MAX=10

# NDA_UPSTREAM_DEADLINE_MS=5000

# How long a `world.tick` lease is held, in milliseconds.
#
# **A SAFETY VALUE, NOT A TUNING KNOB.** A day resolution that outlives its lease can be claimed by
# a second worker while the first is still writing, which is the double-XP-and-double-days-survived
# defect 04-domain-model §10.5 names against `world.tick`. The day re-check in `persistDay` makes
# the second worker's write a no-op even then, but the lease is the first line and should comfortably
# exceed the slowest world's resolution. A floor of five seconds is enforced at boot.
# NDA_TICK_LEASE_MS=120000

# How many due worlds one sweep may enqueue. Bounds the work a single claim creates.
# NDA_TICK_BATCH_SIZE=50

# Names this replica in jobs.locked_by and in a lease's owner column. Defaults to the hostname,
# which is the container id under compose and the pod name under Kubernetes.
# INSTANCE_ID=

# The image tag, reported on every log line and in the release manifest.
# CLOUDSFORGE_TAG=dev

# --- not read by this service ------------------------------------------------------------------
#
# OTEL_EXPORTER_OTLP_ENDPOINT and the rest of OTEL_* are read by the OpenTelemetry SDK loaded ahead
# of the process, not by src/env.ts. They belong in the deploy, not here.
#
# NDA_TEST_DATABASE_URL is read only by the test suite, and only when its name contains "test" —
# the database-backed tests truncate every table this service owns.
#
# The ancestor also read CORS_ORIGINS, TRUST_PROXY and GAME_RATE_LIMIT_MAX. The browser does not
# talk to this service directly any more — `worlds-web` is a separate repository and the edge
# terminates both concerns — and a rate limiter keyed on a spoofable forwarded address was the thing
# the ancestor's own comment there was apologising for.
